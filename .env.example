# Copy to .env.local and fill in. Leave a service's URL empty to disable it.

# Core (required)
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# The URL you open SafeHub at, e.g. http://192.168.1.10:3000
BETTER_AUTH_URL=http://localhost:3000
DATABASE_PATH=./data/safehub.db

# Proxmox VE (Datacenter > Permissions > API Tokens)
# PROXMOX_URL: e.g. https://192.168.1.20:8006
# PROXMOX_TOKEN_ID: user@realm!tokenname, e.g. safehub@pve!dashboard
# Roles: PVEAuditor (read) + PVEVMUser (start/stop). With "Privilege
# Separation" on, assign the roles to the token itself, not only the user.
# TLS: prefer PROXMOX_CA_CERT_PATH = a copy of /etc/pve/pve-root-ca.pem.
PROXMOX_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_CA_CERT_PATH=
PROXMOX_ALLOW_SELF_SIGNED=false

# Synology DSM
SYNOLOGY_URL=
SYNOLOGY_USERNAME=
SYNOLOGY_PASSWORD=
SYNOLOGY_CA_CERT_PATH=
SYNOLOGY_ALLOW_SELF_SIGNED=false

# *arr stack (Settings > General > API Key)
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
PROWLARR_URL=
PROWLARR_API_KEY=
BAZARR_URL=
BAZARR_API_KEY=

# Media and apps
JELLYFIN_URL=
JELLYFIN_API_KEY=
SEERR_URL=
SEERR_API_KEY=
IMMICH_URL=
IMMICH_API_KEY=
CADDY_ADMIN_URL=

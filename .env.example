# All settings are optional. Use this file as .env next to compose.yaml
# (or .env.local for development), or put the same KEY: value pairs under
# environment: in compose.yaml. Leave a service's URL empty to disable it.

# Core
# Login secret. Leave empty: one is generated on first start and kept in
# data/auth-secret. Set it only to choose your own (32+ characters).
BETTER_AUTH_SECRET=
# Only when SafeHub is served over HTTPS (e.g. behind Caddy): its https://
# address, which enables Secure cookies. Leave empty for http://<IP>:3000.
BETTER_AUTH_URL=
# Only with BETTER_AUTH_URL: other addresses you also open SafeHub at,
# comma-separated (e.g. the LAN IP next to the Caddy domain).
BETTER_AUTH_TRUSTED_ORIGINS=
DATABASE_PATH=./data/safehub.db

# Turn off the update check against GitHub (the only outgoing request).
DISABLE_UPDATE_CHECK=false

# Proxmox VE (Datacenter > Permissions > API Tokens)
# PROXMOX_URL: e.g. https://192.168.1.20:8006
# PROXMOX_TOKEN_ID: user@realm!tokenname, e.g. safehub@pve!dashboard
# Roles: PVEAuditor (read) + PVEVMUser (start/stop). With "Privilege
# Separation" on, assign the roles to the token itself, not only the user.
# TLS: the certificate is pinned automatically on first connection. Optional
# overrides: PROXMOX_CA_CERT_PATH (verify against a CA file, e.g. a copy of
# /etc/pve/pve-root-ca.pem) or PROXMOX_ALLOW_SELF_SIGNED=true (no checks).
PROXMOX_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_CA_CERT_PATH=
PROXMOX_ALLOW_SELF_SIGNED=false

# Synology DSM
# SYNOLOGY_URL: e.g. https://192.168.1.10:5001 (or http://...:5000)
# Create a dedicated user for SafeHub: member of "administrators" (DSM's
# system and storage APIs need it), 2FA off, and deny it all apps in
# Control Panel > User > Applications. Do not reuse your own account.
SYNOLOGY_URL=
SYNOLOGY_USERNAME=
SYNOLOGY_PASSWORD=
SYNOLOGY_CA_CERT_PATH=
SYNOLOGY_ALLOW_SELF_SIGNED=false

# *arr stack (Settings > General > API Key)
# URLs are the base address incl. any URL base, e.g. http://192.168.1.101:8989
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
PROWLARR_URL=
PROWLARR_API_KEY=
BAZARR_URL=
BAZARR_API_KEY=

# Media and apps
# Jellyfin: Dashboard > API Keys
JELLYFIN_URL=
JELLYFIN_API_KEY=
# Seerr / Jellyseerr / Overseerr: Settings > General > API Key
SEERR_URL=
SEERR_API_KEY=
# Immich: Account Settings > API Keys. Photo/video stats need an admin's
# key (or the server.statistics permission); otherwise only the version shows.
IMMICH_URL=
IMMICH_API_KEY=

# Copy to .env.local and fill in. Leave a service's URL empty to disable it.

# Core (required)
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# The URL you open SafeHub at, e.g. http://192.168.1.10:3000
BETTER_AUTH_URL=http://localhost:3000
# Optional: other addresses you open SafeHub at, comma-separated
# (e.g. the LAN IP when BETTER_AUTH_URL is a Caddy domain).
BETTER_AUTH_TRUSTED_ORIGINS=
DATABASE_PATH=./data/safehub.db

# Docker only (compose.yaml). PORT: where SafeHub listens on the host.
# PUID/PGID: owner of ./data on the host (Synology: often 1026 / 100).
PORT=3000
PUID=1000
PGID=1000

# Proxmox VE (Datacenter > Permissions > API Tokens)
# PROXMOX_URL: e.g. https://192.168.1.20:8006
# PROXMOX_TOKEN_ID: user@realm!tokenname, e.g. safehub@pve!dashboard
# Roles: PVEAuditor (read) + PVEVMUser (start/stop). With "Privilege
# Separation" on, assign the roles to the token itself, not only the user.
# TLS: prefer PROXMOX_CA_CERT_PATH = a copy of /etc/pve/pve-root-ca.pem.
PROXMOX_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_CA_CERT_PATH=
PROXMOX_ALLOW_SELF_SIGNED=false

# Synology DSM
# SYNOLOGY_URL: e.g. https://192.168.1.10:5001 (or http://...:5000)
# Create a dedicated user for SafeHub: member of "administrators" (DSM's
# system and storage APIs need it), 2FA off, and deny it all apps in
# Control Panel > User > Applications. Do not reuse your own account.
SYNOLOGY_URL=
SYNOLOGY_USERNAME=
SYNOLOGY_PASSWORD=
SYNOLOGY_CA_CERT_PATH=
SYNOLOGY_ALLOW_SELF_SIGNED=false

# *arr stack (Settings > General > API Key)
# URLs are the base address incl. any URL base, e.g. http://192.168.1.101:8989
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
PROWLARR_URL=
PROWLARR_API_KEY=
BAZARR_URL=
BAZARR_API_KEY=

# Media and apps
# Jellyfin: Dashboard > API Keys
JELLYFIN_URL=
JELLYFIN_API_KEY=
# Seerr / Jellyseerr / Overseerr: Settings > General > API Key
SEERR_URL=
SEERR_API_KEY=
# Immich: Account Settings > API Keys. Photo/video stats need an admin's
# key (or the server.statistics permission); otherwise only the version shows.
IMMICH_URL=
IMMICH_API_KEY=
# Caddy admin API has NO authentication: anyone who can reach it can
# reconfigure Caddy. Keep it on localhost/a private interface, set its
# `origins` to allow SafeHub, and never expose it beyond SafeHub's host.
CADDY_ADMIN_URL=
